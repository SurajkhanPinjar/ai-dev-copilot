<idea-plugin>

    <id>io.aidevcopilot.plugin</id>

    <name>AI Dev Copilot</name>

    <vendor>Suraj Pinjar</vendor>

    <description>
        AI Developer Assistant powered by Ollama and Spring Boot.
    </description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>

    <extensions defaultExtensionNs="com.intellij">

        <toolWindow
                id="AI Dev Copilot"
                anchor="right"
                factoryClass="io.aidevcopilot.plugin.toolwindow.AiToolWindowFactory"/>

    </extensions>

    <actions>

        <!-- ========================= -->
        <!-- Editor Popup Menu -->
        <!-- ========================= -->

        <group
                id="AiDevCopilotEditorGroup"
                text="AI Dev Copilot"
                popup="true">

            <add-to-group
                    group-id="EditorPopupMenu"
                    anchor="last"/>

            <!-- Analysis -->

            <action
                    id="ExplainCodeAction"
                    class="io.aidevcopilot.plugin.action.ExplainCodeAction"
                    text="Explain Code"/>

            <action
                    id="CodeReviewAction"
                    class="io.aidevcopilot.plugin.action.CodeReviewAction"
                    text="Review Code"/>

            <action
                    id="BugFinderAction"
                    class="io.aidevcopilot.plugin.action.BugFinderAction"
                    text="Find Bugs"/>

            <separator/>

            <!-- Generation -->

            <action
                    id="OptimizeCodeAction"
                    class="io.aidevcopilot.plugin.action.OptimizeCodeAction"
                    text="Optimize Code"/>

            <action
                    id="GenerateTestsAction"
                    class="io.aidevcopilot.plugin.action.GenerateTestsAction"
                    text="Generate Tests"/>

            <action
                    id="GenerateJavaDocAction"
                    class="io.aidevcopilot.plugin.action.GenerateJavaDocAction"
                    text="Generate JavaDoc"/>

            <separator/>

            <!-- Framework -->

            <action
                    id="SpringAdvisorAction"
                    class="io.aidevcopilot.plugin.action.SpringAdvisorAction"
                    text="Spring Boot Advisor"/>

            <action
                    id="SqlExplainAction"
                    class="io.aidevcopilot.plugin.action.SqlExplainAction"
                    text="Explain SQL"/>

            <action
                    id="ArchitectureReviewAction"
                    class="io.aidevcopilot.plugin.action.ArchitectureReviewAction"
                    text="Architecture Review"/>

        </group>

        <!-- ========================= -->
        <!-- Project Popup Menu -->
        <!-- ========================= -->

        <group
                id="AiDevCopilotProjectGroup"
                text="AI Dev Copilot"
                popup="true">

            <add-to-group
                    group-id="ProjectViewPopupMenu"
                    anchor="last"/>

            <action
                    id="AnalyzeProjectAction"
                    class="io.aidevcopilot.plugin.action.AnalyzeProjectAction"
                    text="Analyze Project"
                    description="Analyze the current IntelliJ project"/>

        </group>

    </actions>

</idea-plugin>